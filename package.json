{
    "name": "@particle-academy/classroom",
    "version": "0.7.0",
    "description": "Classroom UX — course-taking and testing surface for the laravel-courses API, built on Fancy UI primitives.",
    "keywords": [
        "courses",
        "classroom",
        "lms",
        "react",
        "tailwind",
        "particle-academy"
    ],
    "homepage": "https://github.com/Particle-Academy/classroom",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Particle-Academy/classroom.git"
    },
    "bugs": "https://github.com/Particle-Academy/classroom/issues",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepublishOnly": "tsup",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "@particle-academy/react-fancy": ">=5.19",
        "axios": ">=1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@particle-academy/react-fancy": "^5.19.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "axios": "^1.20.0",
        "jsdom": "^29.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "overrides": {
        "esbuild": "^0.28.1",
      "brace-expansion": "^5.0.12",
      "undici": "^7.29.1"
    }
}
